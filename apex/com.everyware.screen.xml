<!-- The panel serves the screen link to the dashboard bundle (screen_binder.rs): a vintf-stable
     interface in a vendor APEX, declared here so servicemanager takes the registration. -->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>com.everyware.screen</name>
        <version>1</version>
        <fqname>IScreenLink/default</fqname>
    </hal>
</manifest>
